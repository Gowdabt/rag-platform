# Application
RAG_ENV=development
RAG_CONFIG_DIR=configs

# Required for runtime secret resolution (compose sets these)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
DATABASE_URL_SYNC=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO or AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ragminio
S3_SECRET_KEY=ragminio_secret
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# Local folder connector: comma-separated directories the API may read
# CONNECTOR_FS_ROOTS=/Users/you/Documents,/Users/you/knowledge

# Google Drive — OAuth web client. Redirect URIs:
#   http://127.0.0.1:5173/sources
#   http://localhost:5173/sources
# Or paste client ID/secret on Sources → Log in (no restart needed).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OneDrive / SharePoint (one Azure app covers both)
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

# Dropbox
# DROPBOX_OAUTH_CLIENT_ID=
# DROPBOX_OAUTH_CLIENT_SECRET=

# Include mock_* connectors in the catalog (tests only)
# RAG_CONNECTOR_MOCKS=0


# JWT (Phase 2). Placeholder only — production refuses to start if this is missing, short, or still a change-me value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Platform Super Admin (seeded on API startup). Placeholders only — set real values in .env, never commit them.
PLATFORM_SUPERADMIN_EMAIL=admin@example.com
PLATFORM_SUPERADMIN_PASSWORD=change-me-long-password

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud providers — leave unset unless a tenant overlay selects them
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=
# VOYAGE_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# PINECONE_API_KEY=
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
